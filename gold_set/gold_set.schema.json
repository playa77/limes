{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LIMES gold set item",
  "description": "One gold set item (one line of gold_set.jsonl). Labeled from passage text, never from model output (Doc 2 §12.5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "language", "passage", "expected_json", "gold_set_version"],
  "properties": {
    "item_id": {"type": "string", "minLength": 1},
    "language": {"enum": ["de", "en"]},
    "passage": {"type": "string", "minLength": 1},
    "expected_json": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "relation", "object"],
        "properties": {
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface"],
            "properties": {"surface": {"type": "string", "minLength": 1}}
          },
          "relation": {"type": "string", "minLength": 1},
          "object": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface"],
            "properties": {"surface": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "gold_set_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}
