# ---------------------------------------------------------------------------
# LIMES — .gitignore
# Version: 1.0.0 | introduced by WP-01
#
# Two rules govern this file:
#   1. Nothing that the system needs in order to be rebuilt from scratch is
#      ignored. The ontology, the gold set, the feed configuration, the lock
#      file, and .env.example are all committed.
#   2. Nothing containing a secret, a host path, or derived data is committed.
#      The archive and the graph are derivable; secrets are not recoverable.
# ---------------------------------------------------------------------------

# ---------- Secrets and local configuration ----------
.env
.env.*
!.env.example
*.pem
*.key
!ontology/**/*.key          # defensive: no key files are expected here, but a
                            # future ontology property named *.key must not be
                            # silently dropped

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Virtual environments ----------
# Project convention: one venv per project directory, at ./venv/.
venv/
.venv/
env/
ENV/
.python-version

# ---------- Dependency locking ----------
# The lock file IS committed. It is the pinned dependency record and the
# reason a rebuild is reproducible. Do not add it here.
!uv.lock
!poetry.lock

# ---------- Tooling caches ----------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# ---------- Runtime data (derivable; never committed) ----------
# The raw archive is the system of record for rebuilds, but it is large and
# machine-local. Back it up; do not version it.
data/
/archive/
*.dump
*.dump.gz

# ---------- Neo4j ----------
neo4j/
neo4j_data/
neo4j_logs/
neo4j_import/
neo4j_plugins/
*.transaction.db

# ---------- Models and large binaries ----------
# spaCy models install into the container image, never into the repository.
*.whl
models/
*.bin
*.pt
*.gguf
*.safetensors

# ---------- Logs ----------
logs/
*.log
*.log.*

# ---------- Test artifacts ----------
# Recorded HTTP fixtures ARE committed: adapter tests must not hit the network.
tests/fixtures/**/*.tmp
tests/output/
.pytest-tmp/

# ---------- Evaluation output ----------
# The gold set and calibration set are committed. Their run output is not.
gold_set/runs/
evaluation_output/

# ---------- Editors and IDEs ----------
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.\#*
\#*\#

# ---------- Operating system ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Explicitly tracked, stated for the avoidance of doubt ----------
# ontology/ontology.yaml          the declarative artifact; the system will not
#                                 start without it
# ontology/ontology.schema.json
# ontology/feeds.yaml
# ontology/migrations/*.py
# gold_set/gold_set.jsonl         the measuring instrument; losing it means
#                                 losing every quality baseline
# reference_questions/questions.yaml
# docs/*.md                       the specification set
# .env.example                    the authoritative key list

# Split runtime configuration; examples are tracked.
/config/*.env
/config/*.env.lock
work/

/config/*.evaluation.json
