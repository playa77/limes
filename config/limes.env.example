# Non-secret tunables. Copy to config/limes.env; model selection writes pins here.
LIMES_EXTRACTION_MODEL=
LIMES_ADJUDICATION_MODEL=
LIMES_EMBEDDING_MODEL=
LIMES_NL2CYPHER_MODEL=
LIMES_MODEL_PIN_STAGE=provisional
LIMES_MODEL_PIN_DATE=
# Optional completion parameters; empty means provider default.
LIMES_INFERENCE_TEMPERATURE=
LIMES_INFERENCE_MAX_TOKENS=
LIMES_INFERENCE_REASONING_EFFORT=
